{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flipdish API - Apps Accounts Features API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.flipdish.co/identity/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Flipdish Enable Features",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.flipdish.co/api/v1.0/:appId/features/enable",
            "params": [
              {
                "name": "appId",
                "value": "500123",
                "type": "path",
                "description": "The app id path parameter."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.flipdish.co/identity/connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Enable Features via the Flipdish Open API v1.0 (POST /api/v1.0/{appId}/features/enable)."
        },
        {
          "info": {
            "name": "Flipdish Disable Features",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.flipdish.co/api/v1.0/:appId/features/disable",
            "params": [
              {
                "name": "appId",
                "value": "500123",
                "type": "path",
                "description": "The app id path parameter."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.flipdish.co/identity/connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Disable Features via the Flipdish Open API v1.0 (POST /api/v1.0/{appId}/features/disable)."
        }
      ]
    }
  ],
  "bundled": true
}